GNUSTEP_INSTALLATION_DOMAIN = SYSTEM
ADDITIONAL_INCLUDE_DIRS += -I../WindowManager
# The size arithmetic is plain Foundation, built with ARC like the window manager
cursorsize_OBJC_FILES += ../WindowManager/URSCursorSize.m ../WindowManager/URSOutputScale.m
../WindowManager/URSCursorSize.m_FILE_FLAGS += -fobjc-arc
../WindowManager/URSOutputScale.m_FILE_FLAGS += -fobjc-arc
